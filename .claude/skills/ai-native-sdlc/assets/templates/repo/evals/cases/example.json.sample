{
  "name": "example-bug-fix",
  "description": "Copy this file to <name>.json and replace every value with a real, recent task.",
  "base_ref": "HEAD",
  "prompt": "Describe the task exactly as a teammate would have asked for it.",
  "allowed_tools": "Read,Edit,Write,Grep,Glob,Bash(make test *)",
  "checks": [
    "make test",
    "make lint"
  ]
}
